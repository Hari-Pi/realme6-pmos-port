# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Dazai <dazai@gmail.com>
pkgname=device-realme-nemo
pkgdesc="Realme 6 (RMX2001)"
pkgver=2
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools-avbtool
	android-tools-mkbootimg
	linux-realme-nemo
	postmarketos-base
"
makedepends="android-tools-mkdtboimg devicepkg-dev dtc"
source="deviceinfo kernel-cmdline.conf modules-initfs finalize-bootimg.sh"

build() {
	devicepkg_build $startdir $pkgname

	# MTK LK bootloader requires a recovery_dtbo (even if empty)
	mkdir -p "$builddir"
	echo '/dts-v1/;/{};' | dtc -I dts -O dtb -o "$builddir/empty.dtb"
	mkdtboimg create "$builddir/empty.dtbo" "$builddir/empty.dtb"
}

package() {
	devicepkg_package $startdir $pkgname

	mkdir -p "$pkgdir/boot"
	install -Dm644 "$builddir/empty.dtbo" \
		"$pkgdir/boot/"
	install -Dm755 "$srcdir/finalize-bootimg.sh" \
		"$pkgdir/usr/share/$pkgname/finalize-bootimg.sh"
}

