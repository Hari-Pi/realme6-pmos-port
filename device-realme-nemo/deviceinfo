# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="Realme 6"
deviceinfo_manufacturer="Realme"
deviceinfo_codename="realme-nemo"
deviceinfo_year="2020"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_drm="false"
deviceinfo_external_storage="true"
deviceinfo_rootfs_image_sector_size="4096"

# Downstream kernel uses the MediaTek USB gadget controller. Keep the
# postmarketOS USB network deterministic for initramfs diagnostics and SSH.
deviceinfo_usb_network_function="rndis.usb0"
deviceinfo_usb_network_udc="musb-hdrc"

# Bootimg related
# Uses --recovery_dtbo with empty.dtbo like begonia (MTK LK bootloader requirement)
deviceinfo_bootimg_custom_args="--header_version 2 --dtb /boot/dtbs/mediatek/mt6785-realme-nemo.dtb --dtb_offset 0x0bc08000 --recovery_dtbo /boot/empty.dtbo --os_version 10.0.0 --os_patch_level 2021-08"
deviceinfo_generate_bootimg="true"
deviceinfo_mkinitfs_postprocess="/usr/share/device-realme-nemo/finalize-bootimg.sh"

# Flashing related
deviceinfo_flash_kernel_on_update="true"
deviceinfo_flash_method="fastboot"
deviceinfo_flash_offset_base="0x40078000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x07c08000"
deviceinfo_flash_offset_second="0xbff88000"
deviceinfo_flash_offset_tags="0x0bc08000"
deviceinfo_flash_offset_dtb="0x0bc08000"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_sparse="true"
