diff --git a/drivers/input/touchscreen/oppo_touchscreen/touchpanel_common_driver.c b/drivers/input/touchscreen/oppo_touchscreen/touchpanel_common_driver.c
index 662ac254ae84..13656e7a4166 100755
--- a/drivers/input/touchscreen/oppo_touchscreen/touchpanel_common_driver.c
+++ b/drivers/input/touchscreen/oppo_touchscreen/touchpanel_common_driver.c
@@ -33,6 +33,16 @@
 #ifdef CONFIG_FB
 #include <linux/fb.h>
 #include <linux/notifier.h>
+
+/*
+ * The MediaTek framebuffer bring-up mode keeps the panel powered when generic
+ * Linux userspace sends transient FBIOBLANK requests.  Keep the incell touch
+ * controller in the same power state; otherwise the framebuffer remains
+ * visible while this notifier suspends touch input.
+ */
+#ifdef CONFIG_MTK_FB
+extern int bypass_blank;
+#endif
 #endif
 
 #ifdef CONFIG_DRM_MSM
@@ -5973,6 +5983,15 @@ static int fb_notifier_callback(struct notifier_block *self, unsigned long event
     struct fb_event *evdata = data;
     struct touchpanel_data *ts = container_of(self, struct touchpanel_data, fb_notif);
 
+#if defined(CONFIG_FB) && defined(CONFIG_MTK_FB)
+    if (bypass_blank &&
+        (event == FB_EARLY_EVENT_BLANK || event == FB_EVENT_BLANK)) {
+        TPD_DEBUG("ignore framebuffer blank event %lu in bypass mode\n",
+                  event);
+        return 0;
+    }
+#endif
+
     //to aviod some kernel bug (at fbmem.c some local veriable are not initialized)
 #ifdef CONFIG_DRM_MSM
     if(event != MSM_DRM_EARLY_EVENT_BLANK && event != MSM_DRM_EVENT_BLANK)
diff --git a/drivers/misc/mediatek/video/mt6785/videox/debug.c b/drivers/misc/mediatek/video/mt6785/videox/debug.c
index 43eec3c4c3c5..ac2a19eb9bc3 100644
--- a/drivers/misc/mediatek/video/mt6785/videox/debug.c
+++ b/drivers/misc/mediatek/video/mt6785/videox/debug.c
@@ -69,7 +69,15 @@
 
 static struct dentry *mtkfb_dbgfs;
 unsigned int g_mobilelog;
-int bypass_blank;
+/*
+ * Android's SurfaceFlinger coordinates FBIOBLANK with the rest of the
+ * MediaTek display power sequence.  A generic Linux initramfs does not, and
+ * its splash/virtual-keyboard clients can issue transient blank requests
+ * that repeatedly suspend, reset and resume the panel.  Keep the panel
+ * powered during postmarketOS bring-up; brightness and explicit system power
+ * management remain available through their dedicated paths.
+ */
+int bypass_blank = 1;
 int lcm_mode_status;
 int layer_layout_allow_non_continuous;
 
